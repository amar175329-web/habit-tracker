<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Explicit Light Launch Theme for API 31+ (NO night qualifier) -->
    <style name="Theme.Habbit.Splash.Light" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F2F6F5</item>
        <item name="android:windowSplashScreenBackground">#F2F6F5</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash_layer_light</item>
        <item name="android:colorBackground">#F2F6F5</item>
        <item name="android:statusBarColor">#F2F6F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F2F6F5</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Explicit Dark Launch Theme for API 31+ (NO night qualifier) -->
    <style name="Theme.Habbit.Splash.Dark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#060E0E</item>
        <item name="android:windowSplashScreenBackground">#060E0E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash_layer_dark</item>
        <item name="android:colorBackground">#060E0E</item>
        <item name="android:statusBarColor">#060E0E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#060E0E</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.Habbit.Splash.Light" />

</resources>
