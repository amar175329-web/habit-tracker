<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_light"
    android:padding="12dp">

    <!-- Left Section: H Logo + Streak -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.35"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_4x2_logo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/ic_bg_spark"
            android:text="H"
            android:textColor="#0D7B6C"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_4x2_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="🔥"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:id="@+id/widget_4x2_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#E2E8F0"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Right Section: Today's Top 3 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.65"
        android:paddingStart="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/widget_4x2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Today's Top 3"
                android:textColor="#0F172A"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_4x2_add"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_bg_light"
                android:text="+"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />
        </RelativeLayout>

        <!-- Habit 1 -->
        <LinearLayout
            android:id="@+id/widget_4x2_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_4x2_check_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="○"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_4x2_name_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Workout"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Habit 2 -->
        <LinearLayout
            android:id="@+id/widget_4x2_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_4x2_check_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="○"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_4x2_name_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Study"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Habit 3 -->
        <LinearLayout
            android:id="@+id/widget_4x2_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingVertical="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_4x2_check_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="○"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_4x2_name_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Book listening"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
