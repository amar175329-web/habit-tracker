<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_2x2_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_2x2_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_2x2_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_2x2_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aaj shuru karo"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</RelativeLayout>
