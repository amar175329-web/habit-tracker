<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Mode / Night theme values: Pure Black (#0B1112) with white status bar icons -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#2DD4BF</item>
        <item name="colorPrimaryDark">#0B1112</item>
        <item name="colorAccent">#2DD4BF</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#2DD4BF</item>
        <item name="colorPrimaryDark">#0B1112</item>
        <item name="colorAccent">#2DD4BF</item>
        <item name="android:background">#0B1112</item>
        <item name="android:windowBackground">#0B1112</item>
        <item name="android:statusBarColor">#0B1112</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0B1112</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#0B1112</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
