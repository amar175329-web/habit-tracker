<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (White / Light Theme: #F2F6F5 with dark icons) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#0D7B6C</item>
        <item name="colorPrimaryDark">#F2F6F5</item>
        <item name="colorAccent">#0D7B6C</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#0D7B6C</item>
        <item name="colorPrimaryDark">#F2F6F5</item>
        <item name="colorAccent">#0D7B6C</item>
        <item name="android:windowBackground">#F2F6F5</item>
        <item name="android:statusBarColor">#F2F6F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F2F6F5</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Black / Dark Theme: #0B1112 with crisp white icons -->
    <style name="AppTheme.NoActionBar.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#2DD4BF</item>
        <item name="colorPrimaryDark">#0B1112</item>
        <item name="colorAccent">#2DD4BF</item>
        <item name="android:windowBackground">#0B1112</item>
        <item name="android:statusBarColor">#0B1112</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0B1112</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Launch Theme in values-night: Solid Dark (#060E0E) with transparent icon for dark OS devices -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar.Dark">
        <item name="android:background">@drawable/splash_dark</item>
        <item name="android:windowBackground">@drawable/splash_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#060E0E</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/transparent_icon</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
        <item name="android:statusBarColor">#060E0E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#060E0E</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Dark" parent="AppTheme.NoActionBar.Dark">
        <item name="android:background">@drawable/splash_dark</item>
        <item name="android:windowBackground">@drawable/splash_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#060E0E</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/transparent_icon</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
        <item name="android:statusBarColor">#060E0E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#060E0E</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
