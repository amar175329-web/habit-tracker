<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme in values-night (Dark Theme: #0B1112 with white icons) -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#2DD4BF</item>
        <item name="colorPrimaryDark">#0B1112</item>
        <item name="colorAccent">#2DD4BF</item>
        <item name="android:windowBackground">#0B1112</item>
        <item name="android:colorBackground">#0B1112</item>
    </style>

    <!-- In values-night (active when night mode is YES), AppTheme.NoActionBar is Dark -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#2DD4BF</item>
        <item name="colorPrimaryDark">#0B1112</item>
        <item name="colorAccent">#2DD4BF</item>
        <item name="android:windowBackground">#0B1112</item>
        <item name="android:colorBackground">#0B1112</item>
        <item name="android:statusBarColor">#0B1112</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0B1112</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="AppTheme.NoActionBar.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#0D7B6C</item>
        <item name="colorPrimaryDark">#F2F6F5</item>
        <item name="colorAccent">#0D7B6C</item>
        <item name="android:windowBackground">#F2F6F5</item>
        <item name="android:colorBackground">#F2F6F5</item>
        <item name="android:statusBarColor">#F2F6F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F2F6F5</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="AppTheme.NoActionBar.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#2DD4BF</item>
        <item name="colorPrimaryDark">#0B1112</item>
        <item name="colorAccent">#2DD4BF</item>
        <item name="android:windowBackground">#0B1112</item>
        <item name="android:colorBackground">#0B1112</item>
        <item name="android:statusBarColor">#0B1112</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0B1112</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Dark Launch Window in values-night (Strictly Dark: #060E0E + splash_icon_dark) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#060E0E</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#060E0E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon_dark</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar.Dark</item>
        <item name="android:windowBackground">@drawable/splash_layer_dark</item>
        <item name="android:colorBackground">#060E0E</item>
        <item name="android:statusBarColor">#060E0E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#060E0E</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

</resources>
